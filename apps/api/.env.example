# Bu dosyayi .env olarak kopyalayin: cp .env.example .env
# Prisma CLI bu dizindeki .env dosyasini otomatik olarak okur.

# Not: host portu docker-compose.yml'de 55432 olarak ayarli (5432/5433 baska
# servisler tarafindan kullaniliyor olabilir); container icinde Postgres yine
# standart 5432 portunda dinler.
DATABASE_URL="postgresql://grid_up:grid_up@localhost:55432/grid_up?schema=public"
API_PORT=3000

# ---- Notifications (Asama 6) ----
# Aktif notification provider'i secer. Hackathon asamasinda sadece "demo"
# desteklenir: gercek SMS/WhatsApp GONDERMEZ, terminale okunabilir log yazar.
# Ileride gercek bir SMS/WhatsApp gateway'i icin degistirilebilir.
NOTIFICATION_PROVIDER=demo

# Demo provider'in loglarinda/kayitlarinda gorunen alici etiketi (gercek
# telefon numarasi veya API credential DEGIL).
SMS_RECIPIENT="Operations Team"
WHATSAPP_RECIPIENT="Operations Team"
