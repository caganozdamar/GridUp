# Bu dosyayi .env olarak kopyalayin: cp .env.example .env
# Prisma CLI bu dizindeki .env dosyasini otomatik olarak okur.

# Not: host portu docker-compose.yml'de 55432 olarak ayarli (5432/5433 baska
# servisler tarafindan kullaniliyor olabilir); container icinde Postgres yine
# standart 5432 portunda dinler.
DATABASE_URL="postgresql://grid_up:grid_up@localhost:55432/grid_up?schema=public"
API_PORT=3000

# ---- Notifications (Asama 6) ----
# Aktif notification provider'i secer:
#   demo -> (varsayilan) gercek SMS/WhatsApp GONDERMEZ, terminale okunabilir log yazar.
#   http -> yapilandirilabilir HTTP gateway'ine POST eder (asagidaki NOTIFICATION_GATEWAY_*).
# Bilinmeyen bir deger ya da eksik gateway URL'i uygulama acilisinda hata verir.
NOTIFICATION_PROVIDER=demo

# Alicilar: virgulle ayrilmis telefon numaralari (E.164, ornek "+905551112233,
# +905554445566"). demo provider'da okunabilir bir etiket olabilir. Gercek
# numaralar kisisel veridir (KVKK): bu dosyayi/.env'i repoya EKLEMEYIN.
SMS_RECIPIENT="Operations Team"
WHATSAPP_RECIPIENT="Operations Team"

# http provider ayarlari (yalnizca NOTIFICATION_PROVIDER=http iken gerekir).
# Gercek hesap olmadan denemek icin yerel emulator (kok dizinden): npm run mock:sms
#   NOTIFICATION_GATEWAY_URL=http://localhost:4010/send
# NOTIFICATION_GATEWAY_URL=
# NOTIFICATION_GATEWAY_TOKEN=
# NOTIFICATION_GATEWAY_TIMEOUT_MS=3000

# Gonderim hatasinda yeniden deneme: toplam deneme sayisi ve ilk bekleme (her
# denemede iki katina cikar).
# NOTIFICATION_MAX_ATTEMPTS=3
# NOTIFICATION_RETRY_BACKOFF_MS=500

# inline | background. Varsayilan: demo -> inline, http -> background (yavas bir
# gateway ingestion/risk hattini bekletmez).
# NOTIFICATION_DISPATCH=background
