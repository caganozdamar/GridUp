{
  "name": "@grid-up/scada-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "GRID UP verilerini Modbus TCP holding register'lari olarak sunan SCADA gateway/adapter (Asama 7)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src/",
    "test": "vitest run",
    "scada:read": "tsx src/read-client.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "modbus-serial": "^8.0.25"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
