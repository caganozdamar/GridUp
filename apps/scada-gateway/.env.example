# Bu dosyayi .env olarak kopyalayip degerleri kendi ortaminiza gore duzenleyin.
# cp .env.example .env

# SCADA Gateway'in snapshot okuyacagi GRID UP backend API adresi.
API_BASE_URL=http://localhost:3000

# Modbus TCP server'in dinleyecegi port. Gelistirme ortaminda ayricalikli
# port / cakisma yasanmamasi icin varsayilan 1502 kullanilir. Production'da
# uygun oldugunda standart Modbus TCP portu 502'ye map edilebilir
# (bkz. docs/modbus-register-map.md).
MODBUS_TCP_PORT=1502

# GRID UP API'den ne siklikla yeni snapshot cekilecegi (ms).
SCADA_REFRESH_INTERVAL_MS=2000

# Bir panonun en son sensor reading'i bu sureden (ms) daha eskiyse, o
# panonun Data Quality register'i INVALID (0) olarak isaretlenir.
SCADA_DATA_STALE_MS=10000

# scada:read test client'inin baglanacagi host (varsayilan localhost).
# MODBUS_HOST=127.0.0.1

# Dashboard'daki SCADA ekrani icin READ-ONLY HTTP ucu: Modbus register
# tablosunu JSON olarak gosterir (yalnizca GET). Port 0 = kapali.
# Varsayilan olarak yalnizca bu makineden erisilir; docker/on-prem'de 0.0.0.0.
SCADA_HTTP_PORT=1580
SCADA_HTTP_HOST=127.0.0.1
# Dashboard'un adresi (CORS). Bos birakilirsa "*" (yalnizca yerel gelistirme icin).
# SCADA_HTTP_ALLOWED_ORIGIN=http://localhost:5173

