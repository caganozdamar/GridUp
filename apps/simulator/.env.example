# Bu dosyayi .env olarak kopyalayip degerleri kendi ortaminiza gore duzenleyin.
# cp .env.example .env

# Simulator'in verileri gonderecegi backend API adresi.
API_BASE_URL=http://localhost:3000

# Her tick arasindaki sure (ms). Tum ONLINE panolar icin yeni okuma uretilir.
SIMULATION_INTERVAL_MS=2000

# Calisacak senaryo: NORMAL | OVERHEATING | OVERCURRENT | HIGH_HUMIDITY | ARC_FLASH | COMBINED_FAILURE
SIMULATION_SCENARIO=NORMAL

# Belirtilirse, sadece bu koddaki pano SIMULATION_SCENARIO'yu calistirir;
# diger tum ONLINE panolar NORMAL kalir. Bos birakilirsa SIMULATION_SCENARIO
# tum panolara uygulanir.
# TARGET_PANEL_CODE=PANO-003

# Panonun anma akimi (A); akim okumalari buna oranla olceklenir. API ile ayni olmali (1600 kVA icin 2312).
PANEL_RATED_CURRENT_A=150
