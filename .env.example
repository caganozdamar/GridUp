# Bu dosyayi .env olarak kopyalayip degerleri kendi ortaminiza gore duzenleyin.
# cp .env.example .env

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=grid_up
POSTGRES_PASSWORD=grid_up
POSTGRES_DB=grid_up
# Host makinede zaten 5432 (ve 5433) portunda calisan baska servisler
# olabilecegi icin varsayilan host portu 55432 olarak ayarlandi
# (container icinde Postgres yine standart 5432 portunda dinler).
POSTGRES_PORT=55432

# ---- Backend (apps/api) ----
# Docker Compose ile ayaga kaldirilan Postgres'e baglanmak icin kullanilir.
DATABASE_URL="postgresql://grid_up:grid_up@localhost:55432/grid_up?schema=public"
API_PORT=3000

# ---- Frontend (apps/web) ----
VITE_API_BASE_URL="http://localhost:3000"
